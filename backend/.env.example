ANTHROPIC_API_KEY=
OPEN_CHARGE_MAP_KEY=      # optional; mock data used if empty
DATABASE_URL="file:./dev.db"
PORT=4000
DEMO_OFFLINE=false
# Chatbot LLM: claude | gemini | sarvam | offline. Unset = the first of those with a key.
# Whatever is chosen, the chat falls back Claude -> Gemini -> Sarvam -> offline assistant on errors.
LLM_PROVIDER=
# Google Gemini (aistudio.google.com/apikey) and its chat model (default gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
# Sarvam chat model (default sarvam-105b-conversations; sarvam-105b reasons longer but is much slower)
SARVAM_CHAT_MODEL=

# Sarvam AI (Indian-language speech-to-text, text-to-speech, translation)
SARVAM_API_KEY=

# Cognee (long-term memory for the copilot)
COGNEE_API_URL=https://tenant-c0b5ef5d-f41d-4efa-a1ed-f1d2ca9d61f2.aws.cognee.ai
COGNEE_API_KEY=
